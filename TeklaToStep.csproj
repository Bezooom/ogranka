<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net48</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>TeklaToStep</RootNamespace>
    <AssemblyName>TeklaToStep</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
  </PropertyGroup>

  <!-- Compile-time facades only. The net48 exe has no extra runtime dependencies. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <TeklaBin Condition="'$(TeklaBin)' == '' and '$(TEKLA_BIN)' != ''">$(TEKLA_BIN)</TeklaBin>
    <TeklaBin Condition="'$(TeklaBin)' == ''">C:\Program Files\Tekla Structures\2024.0\bin</TeklaBin>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(TeklaBin)\Tekla.Structures.Model.dll')">
    <Reference Include="Tekla.Structures">
      <HintPath>$(TeklaBin)\Tekla.Structures.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Tekla.Structures.Model">
      <HintPath>$(TeklaBin)\Tekla.Structures.Model.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <PropertyGroup Condition="Exists('$(TeklaBin)\Tekla.Structures.Model.dll')">
    <DefineConstants>$(DefineConstants);TEKLA</DefineConstants>
  </PropertyGroup>
</Project>
